---
import ArticlePage from '../../components/ArticlePage.astro';
import { getWriting, neighbours } from '../../lib/writing';

export async function getStaticPaths() {
  const { all } = await getWriting('zh', import.meta.env.DEV);
  return all.map((post) => ({
    params: { slug: post.id },
    props: { post, ...neighbours(all, post.id) },
  }));
}

const { post, prev, next } = Astro.props;
---
<ArticlePage lang="zh" post={post} prev={prev} next={next} />
