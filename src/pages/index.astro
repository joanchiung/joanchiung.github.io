---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Download from '@lucide/astro/icons/download';
import ExternalLink from '@lucide/astro/icons/external-link';

const isDev = import.meta.env.DEV;
const projects = (await getCollection('projects'))
  .filter((p) => p.data.lang === 'zh')
  .filter((p) => isDev || !p.data.draft)
  .sort((a, b) => b.data.order - a.data.order);
---
<Base
  title="張瓊文 Joan Chang — 前端工程師"
  description="前端工程師，前身為 11 年品牌與 UX/UI 設計師。在受監管的金融系統裡把模糊需求拆解成可執行的介面。"
  page="home"
>
  <h1>張瓊文<span class="name-latin">Joan Chang</span></h1>
  <p class="role-line">前端工程師｜銀行級 Web3 與金融科技系統</p>

  <div class="gc">
    <section>
      <div class="eyebrow">Why</div>
      <p class="why-line">設計背景的前端工程師。<br />我把模糊、未定義的需求，拆解成可以執行的介面。</p>
    </section>

    <section>
      <div class="eyebrow">How</div>
      <ul class="signal">
        <li>11 年品牌與 UX/UI 設計，2023 年轉前端</li>
        <li>現在做受監管的加密貨幣托管系統，服務銀行與執法機關</li>
        <li>邊做邊寫，把學到的概念真的弄懂 —— 前端、區塊鏈、金融、能源</li>
      </ul>
    </section>

    <section>
      <div class="eyebrow">What</div>
      <p class="what-links">
        <a href="/writing/">文章 →</a>
        <a href="/about/">關於我 →</a>
      </p>
    </section>
  </div>

  <section class="projects">
    <div class="eyebrow">作品</div>
    {projects.length === 0 && <p style="color:var(--muted-text)">整理中。</p>}
    <ul class="card-list">
      {projects.map((p) => (
        <li>
          <div class="project-card">
            <div class="project-head">
              <span class="t">{p.data.title}</span>
              {p.data.status && <span class="status-tag">{p.data.status}</span>}
            </div>
            <p class="d">{p.data.description}</p>
            {p.data.tech.length > 0 && <p class="tech">{p.data.tech.join(' · ')}</p>}
            {(p.data.repo || p.data.demo) && (
              <p class="project-links">
                {p.data.repo && <a href={p.data.repo}><ExternalLink size={14} stroke-width={2} /> GitHub</a>}
                {p.data.demo && <a href={p.data.demo}><ExternalLink size={14} stroke-width={2} /> Demo</a>}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <div class="resume-card">
    <div class="resume-meta">
      <div class="eyebrow">履歷</div>
      <p>前端工程師 · React / Next.js / TypeScript · 銀行級 Web3 與金融科技</p>
      <span class="resume-note">2026-03 版（更新中）</span>
    </div>
    <div class="resume-actions">
      <a class="btn" href="/joan-chang-cv.pdf" download><Download size={14} stroke-width={2} />下載履歷</a>
      <a class="btn btn-ghost" href="/joan-chang-cv.pdf" target="_blank" rel="noopener">線上看</a>
    </div>
  </div>
</Base>
