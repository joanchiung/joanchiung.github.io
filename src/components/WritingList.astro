---
import { fmtDate, slugOf, type Post } from '../lib/writing';
import { useT, base as localeBase, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  featured?: Post[];      // passed on page 1 only
  posts: Post[];          // this page's timeline posts
  pager?: { current: number; last: number; prevUrl: string | null; nextUrl: string | null };
}
const { lang, featured, posts, pager } = Astro.props;
const base = localeBase(lang);
const t = useT(lang);

const showFeatured = featured && featured.length > 0;
---
<div class="eyebrow">{t('writing.eyebrow')}</div>
<h1>{t('writing.title')}</h1>
<p style="color:var(--muted-text);max-width:34rem">{t('writing.intro')}</p>

{showFeatured && (
  <section class="featured">
    <div class="eyebrow">{t('writing.featured')}</div>
    <ul class="card-list">
      {featured!.map((p) => (
        <li>
          <a href={`${base}/writing/${slugOf(p)}/`}>
            <span class="t">{p.data.title}</span>
            {p.data.description && <span class="d">{p.data.description}</span>}
            <span class="meta">{fmtDate(p.data.date)}{p.data.tags.length > 0 && ` · ${p.data.tags.join(' / ')}`}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<section>
  {showFeatured && <div class="eyebrow" style="margin-top:3rem">{t('writing.all')}</div>}
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <a href={`${base}/writing/${slugOf(p)}/`}>{p.data.title}</a>
        <div class="meta">{fmtDate(p.data.date)}{p.data.tags.length > 0 && ` · ${p.data.tags.join(' / ')}`}</div>
      </li>
    ))}
  </ul>

  {pager && pager.last > 1 && (
    <nav class="pager">
      {pager.prevUrl ? <a href={pager.prevUrl}>{t('writing.pager.prev')}</a> : <span></span>}
      <span class="pager-count">{pager.current} / {pager.last}</span>
      {pager.nextUrl ? <a href={pager.nextUrl}>{t('writing.pager.next')}</a> : <span></span>}
    </nav>
  )}
</section>
