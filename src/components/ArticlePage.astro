---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { fmtDate, slugOf, getWriting, type Post } from '../lib/writing';
import { useT, base as localeBase, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  post: Post;
  prev: Post | null;
  next: Post | null;
}
const { lang, post, prev, next } = Astro.props;
const t = useT(lang);
const b = localeBase(lang);
const brand = lang === 'en' ? 'Joan Chang' : '張瓊文';
const { Content } = await render(post);

// Language switch: jump to the counterpart post if it exists, otherwise fall back to the writing list
const otherLang = lang === 'en' ? 'zh' : 'en';
const otherBase = localeBase(otherLang);
const slug = slugOf(post);
const { all: otherAll } = await getWriting(otherLang, import.meta.env.DEV);
const hasCounterpart = otherAll.some((p) => slugOf(p) === slug);
const altPath = hasCounterpart
  ? `${otherBase}/writing/${slug}/`
  : `${otherBase}/writing/`;
---
<Base
  title={`${post.data.title} — ${brand}`}
  description={post.data.description}
  lang={lang}
  page="writing"
  reading
  altPath={altPath}
>
  <article class="article">
    <h1>{post.data.title}</h1>
    <div class="meta">
      {fmtDate(post.data.date)}{post.data.tags.length > 0 && ` · ${post.data.tags.join(' / ')}`}
    </div>
    <Content />
  </article>

  <nav class="post-nav">
    {prev ? (
      <a href={`${b}/writing/${slugOf(prev)}/`}><span class="dir">{t('post.prev')}</span><span class="ttl">{prev.data.title}</span></a>
    ) : <span></span>}
    {next ? (
      <a class="right" href={`${b}/writing/${slugOf(next)}/`}><span class="dir">{t('post.next')}</span><span class="ttl">{next.data.title}</span></a>
    ) : <span></span>}
  </nav>

  <a class="back" href={`${b}/writing/`}>{t('writing.back')}</a>
</Base>
