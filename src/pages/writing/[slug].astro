---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getWriting, fmtDate, neighbours } from '../../lib/writing';

export async function getStaticPaths() {
  const { all } = await getWriting('zh', import.meta.env.DEV);
  return all.map((post) => ({
    params: { slug: post.id },
    props: { post, ...neighbours(all, post.id) },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} — 張瓊文`} description={post.data.description} page="writing" reading altPath="/en/writing/">
  <article class="article">
    <h1>{post.data.title}</h1>
    <div class="meta">
      {fmtDate(post.data.date)}{post.data.tags.length > 0 && ` · ${post.data.tags.join(' / ')}`}
    </div>
    <Content />
  </article>

  <nav class="post-nav">
    {prev ? (
      <a href={`/writing/${prev.id}/`}><span class="dir">上一篇</span><span class="ttl">{prev.data.title}</span></a>
    ) : <span></span>}
    {next ? (
      <a class="right" href={`/writing/${next.id}/`}><span class="dir">下一篇</span><span class="ttl">{next.data.title}</span></a>
    ) : <span></span>}
  </nav>

  <a class="back" href="/writing/">← 回文章列表</a>
</Base>
