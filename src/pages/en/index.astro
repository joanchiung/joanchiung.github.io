---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Download from '@lucide/astro/icons/download';
import ExternalLink from '@lucide/astro/icons/external-link';

const isDev = import.meta.env.DEV;
const projects = (await getCollection('projects'))
  .filter((p) => p.data.lang === 'zh') // 英文作品卡沿用中文資料，等 i18n
  .filter((p) => isDev || !p.data.draft)
  .sort((a, b) => b.data.order - a.data.order);
---
<Base
  title="Joan Chang — Frontend Engineer"
  description="Frontend engineer, formerly a brand & UX/UI designer for 11 years. I break vague requirements into shippable interfaces inside regulated finance."
  lang="en"
  page="home"
>
  <p class="todo">English copy is a rough pass — final wording comes after the Chinese version is locked.</p>

  <h1>Joan Chang</h1>
  <p class="role-line">Frontend Engineer · Bank-grade Web3 & fintech systems</p>

  <div class="gc">
    <section>
      <div class="eyebrow">Why</div>
      <p class="why-line">I break vague, undefined requirements<br />into a path you can actually execute.</p>
    </section>

    <section>
      <div class="eyebrow">How</div>
      <ol>
        <li><strong>Design background</strong> — 11 years in brand and UX/UI design; moved into engineering in 2023, bringing that judgement into the code.</li>
        <li><strong>Now</strong> — building M-Key, a crypto custody platform for banks and law-enforcement agencies: vault management, approval workflows, design-system foundations.</li>
        <li><strong>Method</strong> — when the spec is unclear, I draw the outline first: who it's for, what the goal is, then ship.</li>
      </ol>
    </section>

    <section>
      <div class="eyebrow">What</div>
      <p>
        <a href="/en/writing/">Writing</a> — notes on frontend, blockchain and finance, learning in public.<br />
        <a href="/en/about/">About</a> — from design judgement to shipping frontend.
      </p>
    </section>
  </div>

  <section class="projects">
    <div class="eyebrow">Projects</div>
    {projects.length === 0 && <p style="color:var(--muted-text)">Coming soon.</p>}
    <ul class="card-list">
      {projects.map((p) => (
        <li>
          <div class="project-card">
            <div class="project-head">
              <span class="t">{p.data.title}</span>
              {p.data.status && <span class="status-tag">{p.data.status}</span>}
              {p.data.draft && <span class="draft-tag">draft</span>}
            </div>
            <p class="d">{p.data.description}</p>
            {p.data.tech.length > 0 && <p class="tech">{p.data.tech.join(' · ')}</p>}
            {(p.data.repo || p.data.demo) && (
              <p class="project-links">
                {p.data.repo && <a href={p.data.repo}><ExternalLink size={14} stroke-width={2} /> GitHub</a>}
                {p.data.demo && <a href={p.data.demo}><ExternalLink size={14} stroke-width={2} /> Demo</a>}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <div class="resume-card">
    <div class="resume-meta">
      <div class="eyebrow">Résumé</div>
      <p>Frontend Engineer · React / Next.js / TypeScript · bank-grade Web3 & fintech</p>
      <span class="resume-note">Mar 2026 (being updated)</span>
    </div>
    <div class="resume-actions">
      <a class="btn" href="/joan-chang-cv.pdf" download><Download size={14} stroke-width={2} />Download résumé</a>
      <a class="btn btn-ghost" href="/joan-chang-cv.pdf" target="_blank" rel="noopener">View</a>
    </div>
  </div>
</Base>
