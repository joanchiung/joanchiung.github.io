---
import WritingListPage from '../../../components/WritingListPage.astro';
import { getWritingPage, writingPagePaths } from '../../../lib/writing';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  return await writingPagePaths('zh', import.meta.env.DEV);
}) satisfies GetStaticPaths;

const num = Number(Astro.params.num);
const data = await getWritingPage('zh', num, import.meta.env.DEV);
---
<WritingListPage lang="zh" page={num} {...data} />
