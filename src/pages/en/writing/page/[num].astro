---
import WritingListPage from '../../../../components/WritingListPage.astro';
import { getWritingPage, writingPagePaths } from '../../../../lib/writing';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  return await writingPagePaths('en', import.meta.env.DEV);
}) satisfies GetStaticPaths;

const num = Number(Astro.params.num);
const data = await getWritingPage('en', num, import.meta.env.DEV);
---
<WritingListPage lang="en" page={num} {...data} />
