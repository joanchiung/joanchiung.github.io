---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'zh' | 'en';
  page?: 'home' | 'writing' | undefined;
  reading?: boolean;
}
const { title, description, lang = 'zh', page, reading = false } = Astro.props;

const t = lang === 'en'
  ? { home: 'Joan Chang', writing: 'Writing' }
  : { home: '張瓊文', writing: '文章' };

const base = lang === 'en' ? '/en' : '';
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-Hant'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ctext y='25' font-size='24'%3E%E2%9C%A6%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <header class="site-nav">
      <a class="nav-pill nav-home" href={`${base}/`}>
        <span class="mark">✦</span>{t.home}
      </a>

      <div class="nav-right">
        <nav class="nav-pill">
          <a href={`${base}/writing/`} aria-current={page === 'writing' ? 'page' : undefined}>{t.writing}</a>
        </nav>

        <details class="lang-switch">
          <summary class="nav-pill" aria-label="切換語言 / Switch language">
            {lang === 'en' ? 'EN' : '中'}
            <span class="chev">▾</span>
          </summary>
          <div class="lang-menu">
            <a href="/" aria-current={lang === 'zh' ? 'true' : undefined}>中文</a>
            <a href="/en/" aria-current={lang === 'en' ? 'true' : undefined}>English</a>
          </div>
        </details>
      </div>
    </header>

    <main class:list={['wrap', { reading }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <span>© 2026 Joan Chang</span>
        <span class="links">
          <a href="/joan-chang-cv.pdf">履歷</a>
          <a href="https://github.com/joanchiung">GitHub</a>
          <a href="https://www.linkedin.com/in/joanvisual">LinkedIn</a>
          <a href="mailto:joankaminari@gmail.com">Email</a>
        </span>
      </div>
    </footer>
  </body>
</html>
